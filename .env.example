# ---------------------------------------------------------------- services/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/site_diary
# Tests ignore DATABASE_URL and boot an embedded Postgres via `pgserver` unless TEST_DATABASE_URL is set.
TEST_DATABASE_URL=

# Auth
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
CORS_ORIGINS=http://localhost:3000

# Gemini (google-genai SDK)
USE_MOCK_GEMINI=true
GEMINI_MODEL=gemini-2.5-flash
# Backend A — AI Studio API key (dev): audio is downloaded from storage and sent inline.
GEMINI_API_KEY=your_key_here
# Backend B — Vertex AI (prod): audio passed by gs:// URI. Set GOOGLE_GENAI_USE_VERTEXAI=true + ADC.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_MAX_ATTEMPTS=3

# Storage
STORAGE_BACKEND=local            # local | gcs
LOCAL_STORAGE_DIR=./.storage
PUBLIC_API_BASE_URL=http://localhost:8000   # used to build local signed URLs (use http://10.0.2.2:8000 from the Android emulator)
MEDIA_URL_SIGNING_SECRET=change_me_too
GCS_BUCKET=
SIGNED_URL_TTL_SECONDS=900

# Permit alerts (python -m app.jobs.permit_alerts)
PERMIT_EXPIRING_SOON_DAYS=14     # must match permits_with_status view
NOTIFIER=console                 # console | email | fcm | email,fcm
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # service-account JSON for FCM HTTP v1 / GCS / Vertex

# Dev seed (python -m app.scripts.seed)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=owner12345
SEED_SUPERVISOR_EMAIL=supervisor@example.com
SEED_SUPERVISOR_PASSWORD=super12345

# ---------------------------------------------------------------- apps/web
API_BASE_URL=http://localhost:8000          # server-side only (Route Handlers / Server Components)
SESSION_COOKIE_SECURE=false                 # true in prod

# ---------------------------------------------------------------- apps/mobile
# Set in apps/mobile/local.properties (not env): api.baseUrl=http://10.0.2.2:8000
