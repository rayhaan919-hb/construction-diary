# Server-side FastAPI backend base URL (never exposed to browser)
API_BASE_URL=http://localhost:8000

# Set to true under HTTPS in staging/production
SESSION_COOKIE_SECURE=false

# Set to true ONLY for local/non-production preview without FastAPI/PostgreSQL
NEXT_PUBLIC_DEMO_MODE=false

# Optional Edge JWT HS256 verification secret (must match FastAPI JWT_SECRET in production)
JWT_SECRET=
